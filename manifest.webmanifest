{
  "name": "BlockAir — Intentional Day in 144 Blocks",
  "short_name": "BlockAir",
  "description": "See how you spend your time by turning every day into a calm, interactive grid of 10-minute blocks.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b1120",
  "theme_color": "#0f172a",
  "categories": ["productivity", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log Focus Block",
      "short_name": "Focus",
      "description": "Log a 30-minute Deep Work block for the current time",
      "url": "./?action=log&category=deep-work&label=Deep+Work&duration=30",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log Movement / Workout",
      "short_name": "Workout",
      "description": "Log a 30-minute Vitality block for the current time",
      "url": "./?action=log&category=vitality&label=Workout&duration=30",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pre-fill Sleep",
      "short_name": "Sleep",
      "description": "Pre-fill today's sleep schedule",
      "url": "./?action=prefill_sleep",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings & Routines",
      "short_name": "Settings",
      "description": "Open settings and routine presets",
      "url": "./?action=settings",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
